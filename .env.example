# Required — kept relative/same-origin on purpose. The browser now only
# ever talks to this app's own /api/* and /sanctum/csrf-cookie routes
# (see app/api/[...path]/route.ts), which proxy server-side to the real
# backend below. This is what keeps auth cookies first-party instead of
# cross-site — see utils/apiProxy.ts for why that matters.
NEXT_PUBLIC_API_URL=/api

# Required — server-only (no NEXT_PUBLIC_ prefix, never sent to the
# browser). The real Laravel API the proxy forwards to. Local dev:
# http://localhost:8000 — no trailing /api, the proxy adds that itself.
API_PROXY_TARGET=http://localhost:8000

# Optional — display/link metadata
NEXT_PUBLIC_APP_NAME=SproutVest
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — defaults to 1440 (24h) if unset. Should match the API's JWT TTL.
NEXT_PUBLIC_JWT_TTL_MINUTES=1440

# Optional — R2/CDN base URL for land/blog images
NEXT_PUBLIC_R2_URL=

# Required for real-time features (admin live chat, notifications)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http